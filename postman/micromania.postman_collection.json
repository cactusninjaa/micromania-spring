						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"PlayStation 5\",\n  \"brand\": \"Sony\",\n  \"price\": 499.99,\n  \"state\": \"BRAND_NEW\",\n  \"releaseDate\": \"2020-11-19\",\n  \"quantityInStock\": 10,\n  \"colors\": [\"BLACK\", \"WHITE\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/consoles",
							"host": ["{{baseUrl}}"],
							"path": ["consoles"]
						}
					}
				},
				{
