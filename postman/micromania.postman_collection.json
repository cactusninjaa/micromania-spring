							"raw": "{{baseUrl}}/consoles",
							"host": ["{{baseUrl}}"],
							"path": ["consoles"]
						}
					}
				},
				{
					"name": "Récupérer une console par id",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/consoles/{{id}}",
							"host": ["{{baseUrl}}"],
							"path": ["consoles", "{{id}}"]
						}
					}
				},
				{
					"name": "Créer une console",
