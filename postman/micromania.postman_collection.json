					}
				},
				{
					"name": "Vendre une console",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/consoles/{{id}}/sell?quantity={{quantity}}&customerId={{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["consoles", "{{id}}", "sell"],
