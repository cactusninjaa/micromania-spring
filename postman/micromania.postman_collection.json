						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"PlayStation 5 Pro\",\n  \"brand\": \"Sony\",\n  \"price\": 599.99,\n  \"state\": \"BRAND_NEW\",\n  \"releaseDate\": \"2024-11-07\",\n  \"quantityInStock\": 5,\n  \"colors\": [\"BLACK\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/consoles/{{id}}",
							"host": ["{{baseUrl}}"],
							"path": ["consoles", "{{id}}"]
